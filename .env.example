# === CONFIGURACIÓN DEL SERVIDOR HTTP ===
PORT=8080
APP_ENV=dev # dev | prod | test
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# === CONFIGURACIÓN DEL PROVEEDOR LLM (MULTI-LLM NATIVE) ===
# Proveedores válidos: openai | gemini | claude | deepseek | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30s

# API Keys según el LLM_PROVIDER seleccionado
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# URL base personalizada (opcional, para Ollama o instancias privadas de DeepSeek)
# Para entorno local fuera de Docker: http://localhost:11434/v1
# Para entorno dentro de Docker Compose: http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1

# === CONFIGURACIÓN DE MEMORIA REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=30m

# === CONFIGURACIÓN DE LA API EXTERNA ===
# URL base de la API a la que llamará la tool (único endpoint: GET /products?q={query})
PRODUCTS_SERVICE_URL=http://localhost:8081
CLIENTS_TIMEOUT=5s
